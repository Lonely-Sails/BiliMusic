{
  "name": "bili-music",
  "version": "1.0.0",
  "description": "Bilibili video-based music player",
  "author": "LonelySail",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron dist-electron/main.js",
    "pack": "bun run build && electron-builder --dir",
    "dist": "bun run build && electron-builder",
    "dist:mac": "bun run build && electron-builder --mac --publish never",
    "dist:win": "bun run build && electron-builder --win --publish never",
    "dist:linux": "bun run build && electron-builder --linux --publish never",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.bilimusic.app",
    "productName": "BiliMusic",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "icons/tray_icon.png"
    ],
    "mac": {
      "icon": "icons/app/macos/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music"
    },
    "win": {
      "icon": "icons/app/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "icons/app/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Audio"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify/json": "^2.2.498",
    "@iconify/vue": "^5.0.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "pinia": "^3.0.4",
    "prettier": "^3.9.6",
    "reka-ui": "^2.10.1",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  }
}
