{
  "name": "bili-music",
  "version": "1.0.0",
  "description": "Bilibili video-based music player",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && mkdir -p dist-electron/api dist-electron/preload && cp electron/api/*.js dist-electron/api/ && cp electron/preload/desktopLyrics.js dist-electron/preload/",
    "preview": "vite preview",
    "start": "electron dist-electron/main.js"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.9.8",
    "vue": "^3.5.0",
    "vue-router": "4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^33.2.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  }
}
